---
import Base from "../layouts/Base.astro";
import JobPanel from "../components/JobPanel.astro";
import {
  VERIFIED_ON, DEFAULT_FILTERS, ROLE_FAMILIES, SENIORITY_LEVELS, REMOTE_SCOPES,
  MIN_SALARY_OPTIONS, SORT_MODES, TITLES, SKILL_CLUSTERS, ATS_COMPANIES, EXTRA_TARGETS,
  BOARDS, REMOTE_GOOD_PHRASES, REMOTE_BAD_PHRASES,
} from "../lib/data.js";
import { ATS_ADAPTERS, buildBooleanQuery, buildPlainQuery } from "../lib/engine.js";

const boardCount = ATS_COMPANIES.length;
const atsPlatforms = [...new Set(ATS_COMPANIES.map((c) => c.ats))].length;

const TABS = [
  { id: "scan", label: "Hidden-jobs scan", icon: "◎", jobs: true },
  { id: "agg", label: "Aggregators", icon: "⇶", jobs: true },
  { id: "hn", label: "HN Who's Hiring", icon: "Y", jobs: true },
  { id: "links", label: "Deep links", icon: "↗", jobs: false },
  { id: "companies", label: "Companies", icon: "▦", jobs: false },
  { id: "guide", label: "Playbook", icon: "✦", jobs: false },
];

const HIRING_LABEL = { worldwide: "🌍 Hires worldwide", "multi-region": "Multi-region", "us-lean": "US-lean" };

// Deep links render with the default query so they work before JS runs.
const defaultTitle = TITLES[0].label;
const defaultSkills = SKILL_CLUSTERS[0].terms;
const defaultBoolean = buildBooleanQuery(defaultTitle, defaultSkills, []);
const defaultPlain = buildPlainQuery(defaultTitle, defaultSkills, []);

const companies = [...ATS_COMPANIES].sort((a, b) => b.payTier - a.payTier || a.name.localeCompare(b.name));

const tips = [
  ["Scan weekly, apply same-day.", "ATS-direct roles get hundreds of applicants within 48 hours of syndication to LinkedIn — here you see them the moment they hit the company board."],
  ["Salary data is leverage.", "Ashby boards publish real bands (shown on every row). Cross-check any offer against levels.fyi before negotiating."],
  ["“US-remote” isn't a closed door.", "Many companies hire international candidates as contractors or through EORs (Deel, Remote.com, Oyster) when the candidate is strong. Staff/Principal-level skills justify asking."],
  ["HN thread = founder access.", "Replies there go straight to hiring managers and founders — no ATS black hole. A new thread opens on the 1st of each month."],
  ["Lead with your differentiators.", "Concrete scale (clusters run, migrations led, costs or incidents cut) and visible open-source or community work separate a Staff+ résumé from the pile."],
];
---

<Base
  title="Hidden Jobs Engine"
  description={`Live Staff/Principal platform roles straight from ${boardCount} company ATS boards, with posted salary bands.`}
>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="#scan" aria-label="Hidden Jobs Engine home">
        <span class="brand-mark" aria-hidden="true">◎</span>
        <span class="brand-name">Hidden Jobs<span class="brand-thin"> Engine</span></span>
      </a>
      <button id="themeBtn" class="icon-btn" type="button" aria-label="Toggle colour theme" title="Toggle theme">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
      </button>
    </div>
  </header>

  <div class="shell">
    <section class="hero">
      <p class="eyebrow">Staff · Principal · Distinguished</p>
      <h1>Platform roles, <em>straight from the source.</em></h1>
      <p class="hero-sub">
        Scans company hiring systems directly from your browser — before roles are syndicated to job boards,
        with real salary bands where the company publishes them.
      </p>
      <dl class="stats">
        <div><dt>ATS boards</dt><dd>{boardCount}</dd></div>
        <div><dt>ATS platforms</dt><dd>{atsPlatforms}</dd></div>
        <div><dt>Remote boards</dt><dd>3</dd></div>
        <div><dt>Backend</dt><dd>None</dd></div>
      </dl>
    </section>

    <div class="app">
      <aside class="sidebar">
        <nav class="tabs" aria-label="Sections">
          {TABS.map((t) => (
            <a class="tab" href={`#${t.id}`} data-tab={t.id}>
              <span class="tab-icon" aria-hidden="true">{t.icon}</span>
              <span class="tab-label">{t.label}</span>
              {t.jobs && <span class="tab-count" data-count={t.id}></span>}
            </a>
          ))}
        </nav>

        <details id="filters" class="filters" open>
          <summary>Filters</summary>
          <div class="filter-body">
            <fieldset class="field">
              <legend>Role families</legend>
              <div class="chips" id="familyChips">
                {ROLE_FAMILIES.map((f) => (
                  <button class="chip is-on" type="button" aria-pressed="true" data-family={f.key}>{f.label}</button>
                ))}
              </div>
            </fieldset>
            <label class="field">
              <span>Seniority</span>
              <select id="senioritySelect">
                {SENIORITY_LEVELS.map((s) => <option value={s.id} selected={s.id === DEFAULT_FILTERS.seniority}>{s.label}</option>)}
              </select>
            </label>
            <label class="field">
              <span>Remote scope</span>
              <select id="scopeSelect">
                {REMOTE_SCOPES.map((s) => <option value={s.id} selected={s.id === DEFAULT_FILTERS.scope}>{s.label}</option>)}
              </select>
            </label>
            <label class="field">
              <span>Salary floor</span>
              <select id="salarySelect">
                {MIN_SALARY_OPTIONS.map((s) => <option value={String(s.id)} selected={s.id === DEFAULT_FILTERS.minSalary}>{s.label}</option>)}
              </select>
            </label>
            <label class="field">
              <span>Sort by</span>
              <select id="sortSelect">
                {SORT_MODES.map((s) => <option value={s.id} selected={s.id === DEFAULT_FILTERS.sort}>{s.label}</option>)}
              </select>
            </label>
            <label class="field">
              <span>Boost keywords</span>
              <input id="keywordsInput" type="text" placeholder="Post-Quantum, GitOps, Airflow" autocomplete="off" />
            </label>
          </div>
        </details>
      </aside>

      <main class="main">
        <JobPanel
          id="scan"
          title="Hidden-jobs scan"
          lede={`Straight from ${boardCount} company ATS APIs — Greenhouse, Ashby, Lever and SmartRecruiters. No middleman.`}
          action="Scan all boards"
          active
        />
        <JobPanel
          id="agg"
          title="Remote-board aggregators"
          lede="RemoteOK, Remotive and Jobicy — merged, de-duplicated and run through your filters."
          action="Fetch listings"
        />
        <JobPanel
          id="hn"
          title="HN “Who is hiring?”"
          lede="Founder-direct posts from the latest monthly thread — roles that never reach a job board."
          action="Fetch latest thread"
        />

        <section id="tab-links" class="panel" data-tab-panel="links" hidden>
          <header class="panel-head">
            <div>
              <h2>Targeted deep links</h2>
              <p class="lede">Builds a precise query from a title and skill focus and opens each board pre-filtered. X-ray links search every company on an ATS platform at once via Google.</p>
            </div>
          </header>
          <div class="builder">
            <label class="field">
              <span>Job title</span>
              <select id="titleSelect">
                {TITLES.map((t) => <option value={t.label}>{t.label}</option>)}
              </select>
            </label>
            <label class="field">
              <span>Extra keywords</span>
              <input id="extraKeywords" type="text" placeholder="Post-Quantum, Zero Trust, Go" autocomplete="off" />
            </label>
            <fieldset class="field span-2">
              <legend>Skill focus</legend>
              <div class="chips" id="skillChips">
                {SKILL_CLUSTERS.map((c, i) => (
                  <button class={`chip${i === 0 ? " is-on" : ""}`} type="button" aria-pressed={String(i === 0)} data-cluster={c.key}>{c.label}</button>
                ))}
              </div>
            </fieldset>
            <div class="field span-2">
              <span>Query preview</span>
              <code id="queryPreview" class="query">{defaultBoolean}</code>
            </div>
          </div>
          <div class="link-grid">
            {BOARDS.map((b) => (
              <a class="link-card" data-board={b.id} href={b.build(b.queryType === "plain" ? defaultPlain : defaultBoolean)} target="_blank" rel="noopener noreferrer">
                <span class="tag">{b.kind}</span>
                <span class="link-name">{b.name}<span class="arrow" aria-hidden="true">↗</span></span>
                <span class="link-note">{b.note}</span>
              </a>
            ))}
          </div>
        </section>

        <section id="tab-companies" class="panel" data-tab-panel="companies" hidden>
          <header class="panel-head">
            <div>
              <h2>Scannable high-pay targets</h2>
              <p class="lede">Every card opens the company's live ATS board. <span class="mono">$$$$</span> is top-of-market pay; open-role counts appear after a scan. Hiring hints are a rough guide — always read each posting's location line.</p>
            </div>
          </header>
          <div class="company-grid">
            {companies.map((c) => (
              <a class="company-card" href={ATS_ADAPTERS[c.ats].boardUrl(c)} target="_blank" rel="noopener noreferrer" data-slug={c.slug}>
                <span class="company-top">
                  <span class="monogram" aria-hidden="true">{c.name[0]}</span>
                  <span class="company-name">{c.name}</span>
                  <span class="pay" title={`Pay tier ${c.payTier} of 3`}>{"$".repeat(c.payTier + 1)}</span>
                </span>
                <span class="company-note">{c.note}</span>
                <span class="pills">
                  <span class={`pill hiring-${c.hiring}`}>{HIRING_LABEL[c.hiring]}</span>
                  <span class="pill dim">{c.ats}</span>
                  <span class="pill dim" data-roles hidden></span>
                </span>
              </a>
            ))}
          </div>
          <h3 class="subhead">More high-pay targets <span class="muted">— no public ATS API, check manually</span></h3>
          <div class="company-grid">
            {EXTRA_TARGETS.map((c) => (
              <a class="company-card" href={c.careers} target="_blank" rel="noopener noreferrer">
                <span class="company-top">
                  <span class="monogram" aria-hidden="true">{c.name[0]}</span>
                  <span class="company-name">{c.name}</span>
                </span>
                <span class="company-note">{c.note}</span>
              </a>
            ))}
          </div>
        </section>

        <section id="tab-guide" class="panel" data-tab-panel="guide" hidden>
          <header class="panel-head">
            <div>
              <h2>Playbook</h2>
              <p class="lede">Landing a high-paying remote role, wherever you're based.</p>
            </div>
          </header>
          <ol class="tips">
            {tips.map(([head, body]) => <li><strong>{head}</strong> {body}</li>)}
          </ol>
          <h3 class="subhead">Reading job posts — remote-scope cheat sheet</h3>
          <div class="cheatsheet">
            <div class="sheet good">
              <h4>Usually means you're eligible</h4>
              <ul>{REMOTE_GOOD_PHRASES.map((p) => <li>{p}</li>)}</ul>
            </div>
            <div class="sheet bad">
              <h4>Usually US residents only</h4>
              <ul>{REMOTE_BAD_PHRASES.map((p) => <li>{p}</li>)}</ul>
            </div>
          </div>
        </section>
      </main>
    </div>

    <footer class="footer">
      <span>Static &amp; client-side — no backend, no keys, no tracking. Data is fetched from public APIs only when you press a button.</span>
      <span>Endpoints verified {VERIFIED_ON}</span>
    </footer>
  </div>

  <script>
    import "../scripts/app.js";
  </script>
</Base>
